rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user is store admin
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'mathishpahasara9@gmail.com' ||
        request.auth.token.role == 'admin'
      );
    }

    // Products: Public read, Admin write
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders: Anyone can create (checkout), Admin can read/update all, Customer can read own
    match /orders/{orderId} {
      allow create: if true;
      allow read: if isAdmin() || (isAuthenticated() && resource.data.customerId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Site settings: Public read, Admin write
    match /site_content/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Users: Owner can read/update own profile, Admin can read/write all
    match /users/{userId} {
      allow read, write: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
    }
  }
}